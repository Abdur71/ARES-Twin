# ARES Twin - Environment Configuration Template
# Copy to .env at the repo root. Every value below is optional; these are the defaults.

# Backend Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (a relative SQLite path is resolved against backend/)
DATABASE_URL=sqlite:///./ares_twin.db

# External APIs (none of these need a key)
DONKI_API_BASE=https://ccmc.gsfc.nasa.gov/DONKI-API/get
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
# True = never call external APIs; use the cached JSON in backend/app/data/*_cache only
SPACEWEATHER_OFFLINE=False
HTTP_TIMEOUT_S=25
# Only needed for api.nasa.gov services (not used by DONKI any more)
NASA_API_KEY=DEMO_KEY

# Mission replay window: the crew lives through the real space weather starting on this date
MISSION_START=2024-01-01
# "Today" in mission days (0-270); the dashboard's mission clock can move it
MISSION_CURRENT_DAY=120

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000
